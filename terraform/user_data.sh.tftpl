#!/bin/bash
set -euxo pipefail
exec > >(tee -a /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

# Register with SSM before slower Docker and CloudWatch setup.
dnf install -y amazon-ssm-agent
systemctl enable --now amazon-ssm-agent

mkdir -p /opt/devops
DOMAIN_NAME='${domain_name}'
if [[ -n "$DOMAIN_NAME" ]]; then
  docker network create devops || true
  cat >/opt/devops/Caddyfile <<CADDY
$DOMAIN_NAME {
  reverse_proxy devops-app:8000
}
CADDY
fi

# Create the deploy script early; it waits while first-boot package setup finishes.
cat >/opt/devops/deploy.sh <<'SCRIPT'
${deploy_script}
SCRIPT
# shellcheck disable=SC2154 # Terraform substitutes these template variables.

sed -i "s|@AWS_REGION@|${aws_region}|g; s|@ENVIRONMENT@|${environment}|g; s|@DOMAIN_NAME@|${domain_name}|g" /opt/devops/deploy.sh
chmod 700 /opt/devops/deploy.sh

# AL2023's curl-minimal already provides curl; installing curl conflicts with it.
dnf update -y
dnf install -y docker amazon-cloudwatch-agent awscli-2
systemctl enable --now docker
aws configure set region '${aws_region}'

if [[ -n "$DOMAIN_NAME" ]]; then
  docker network create devops 2>/dev/null || true
  docker run -d --name devops-proxy --restart unless-stopped --network devops \
    -p 80:80 -p 443:443 -v /opt/devops/Caddyfile:/etc/caddy/Caddyfile:ro \
    -v caddy_data:/data -v caddy_config:/config caddy:2-alpine
fi

cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'JSON'
{"logs":{"logs_collected":{"files":{"collect_list":[
  {"file_path":"/var/log/cloud-init-output.log","log_group_name":"${log_group}","log_stream_name":"{instance_id}/cloud-init"},
  {"file_path":"/var/log/user-data.log","log_group_name":"${log_group}","log_stream_name":"{instance_id}/user-data"},
  {"file_path":"/var/log/amazon/ssm/amazon-ssm-agent.log","log_group_name":"${log_group}","log_stream_name":"{instance_id}/ssm-agent"},
  {"file_path":"/var/lib/docker/containers/*/*.log","log_group_name":"${log_group}","log_stream_name":"{instance_id}/{container_id}"}
]}}}}
JSON
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s \
  || echo "CloudWatch agent bootstrap failed; continuing"

# Best-effort initial launch. The release workflow is the source of truth.
aws ssm get-parameter --region '${aws_region}' --name /devops/ghcr-read-token \
  --with-decryption --query Parameter.Value --output text \
  | docker login ghcr.io -u '${ghcr_username}' --password-stdin \
  && docker pull '${image}' \
  && if [[ -n "$DOMAIN_NAME" ]]; then
       docker run -d --name devops-app --restart unless-stopped --network devops \
         -e PORT=8000 -e ENVIRONMENT='${environment}' '${image}'
     else
       docker run -d --name devops-app --restart unless-stopped -p 80:8000 \
         -e PORT=8000 -e ENVIRONMENT='${environment}' '${image}'
     fi \
  || echo "Initial container did not start; the release workflow will deploy it"
